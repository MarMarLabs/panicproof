{
  "name": "panicproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:migrate": "RUST_LOG=info prisma migrate dev",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "seed": "tsx prisma/seed.ts",
    "seed:pg": "npm run prisma:generate:pg && tsx prisma/seed.ts",
    "render:build": "npm run prisma:generate:pg && npm run db:push:pg && tsx prisma/seed.ts && next build",
    "start:render": "next start -p ${PORT:-10000}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run seed && playwright test",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "openai": "^6.36.0",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.19.3",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
