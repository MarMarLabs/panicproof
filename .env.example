# PanicProof local defaults
# The default Prisma schema uses SQLite at prisma/dev.db, so DATABASE_URL is not
# needed for local demo mode unless you intentionally run against Postgres.

# Optional: use OpenRouter for model-backed extraction/drafting.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4.1-mini"
OPENROUTER_SITE_URL="http://localhost:3000"

# Render/Neon deployment only:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"
